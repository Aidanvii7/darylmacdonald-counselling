# Resend API key — https://resend.com (3000/mo free tier)
# When unset, /api/contact returns { ok: true, demo: true } so the form works in dev.
RESEND_API_KEY=

# The "from" address Resend will send emails as.
# Must be a verified domain in your Resend account (e.g. hello@darylmacdonald.com).
RESEND_FROM_EMAIL=

# Where contact form submissions are delivered (Daryl's inbox).
CONTACT_TO_EMAIL=
